{
  "name": "koki.me",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev --open",
    "prebuild": "bun run fetch:notes && bun run fetch:github",
    "build": "bun run typecheck && astro build",
    "typecheck": "astro check && tsc -p tsconfig.node.json",
    "lint": "eslint --max-warnings=0 .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "test": "vitest",
    "preview": "astro preview",
    "fetch:notes": "bun run ./scripts/fetch-notes.ts",
    "fetch:github": "bun run ./scripts/fetch-github.ts",
    "generate:og": "bun run ./scripts/generate-og.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.2",
    "@ps1ui/core": "0.7.0",
    "astro": "7.1.6",
    "babel-plugin-react-compiler": "1.0.0",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "lucide-react": "1.26.0",
    "p-limit": "7.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite-plugin-svgr": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "9.39.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "astro-eslint-parser": "1.4.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vercel": "48.12.1",
    "vite": "8.2.0",
    "vitest": "4.0.14"
  }
}
