---
// Not a page a visitor navigates to: this renders the social preview image, and
// it lives outside `src/pages/` so Astro's router leaves it alone.
// `astro.config.ts` injects it at `/og` for the dev server only, and
// `scripts/generate-og.ts` screenshots it there.
//
// `src/styles/global.css` is skipped on purpose: it styles scrollbars and
// suppresses the view transition between routes, and a fixed-size 600x315 frame
// that is screenshotted once neither scrolls nor navigates.
import "@ps1ui/core/styles.css";

import config from "@/config";
import { Heading, PS1Root, Stack, Text } from "@ps1ui/core";
import styles from "./OgPage.module.css";

// No site nav: at the size a social timeline renders this, a row of page links
// reads as noise around the text that carries the meaning.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>OG Image</title>
  </head>
  <body>
    <PS1Root>
      <Stack gap="md" align="start" justify="center" className={styles.frame}>
        <Heading level={1}>{config.profile.name}</Heading>
        <Text size="md" variant="muted" className={styles.bio}>
          {config.profile.bio}
        </Text>
      </Stack>
    </PS1Root>
  </body>
</html>
