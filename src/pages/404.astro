---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { NotFoundPage } from "@/views/NotFoundPage";

// `noindex` because this document is what Vercel serves for *every* unmatched
// URL, not just `/404`. Left indexable it would hand a crawler following a dead
// inbound link a canonical of `https://koki.me/404`, turning the error page
// into the canonical target for the whole tail of stale links.
---

<BaseLayout
  title="Not Found"
  description="The page you're looking for doesn't exist."
  noindex
>
  <NotFoundPage />
</BaseLayout>
