---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { WorksPage } from "@/views/WorksPage";

// The one page that hydrates, for the contribution graph alone: its tooltip and
// roving-tabindex keyboard navigation need a component runtime. The island is
// the whole page rather than that one component because a `client:*` directive
// only exists in a template, and `src/pages/` holds routes — hydrating a piece
// of the view would mean composing the page here.
---

<BaseLayout
  title="Works"
  description="Developer tools, CLIs, web apps and other projects I've built."
>
  <WorksPage client:load />
</BaseLayout>
