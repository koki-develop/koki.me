---
import "@ps1ui/core/styles.css";
import "@/styles/global.css";

import SiteHeader from "@/components/site/SiteHeader.astro";
import {
  DEFAULT_THEME,
  THEME_STORAGE_KEY,
  THEMES,
} from "@/components/site/theme";
import config from "@/config";
import { Container, PS1Root, Stack } from "@ps1ui/core";
import { ClientRouter } from "astro:transitions";
import styles from "./BaseLayout.module.css";

type Props = {
  /**
   * Names the page inside the site — the site name is appended here, so this is
   * "Works", not "Works | Koki Sato". Omit it on the page that _is_ the site.
   */
  title?: string;
  description: string;
  /**
   * Set on a document that is served at more than one URL. It suppresses the
   * canonical and og:url tags, which would otherwise name a single address for
   * a page that has none, and asks crawlers to skip it.
   */
  noindex?: boolean;
};

const { title, description, noindex = false } = Astro.props;

const fullTitle = title
  ? `${title} | ${config.profile.name}`
  : config.profile.name;

// The route, not `Astro.url.pathname`: `build.format: "file"` makes the latter
// the emitted file (`/works.html`) at build time, which matches no entry in the
// site's page list and is not the URL the page is served at either.
// `routePattern` is `/`, `/works`, `/notes` — the paths this site actually
// navigates between.
const pathname = Astro.routePattern;

// `Astro.site` is set in astro.config.ts, so this is never relative.
const canonical = noindex ? null : new URL(pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
{
  /* The theme lives on <html>, not on the PS1Root below it: ps1ui's base.css
     paints the canvas on <html>, which sits outside any PS1Root, so a
     PS1Root-scoped theme would leave the page's own background — and the area
     an overscroll reveals — on the other one. Written out as a plain attribute
     rather than applied from script, so it holds with JavaScript turned off. */
}
<html lang="en" data-ps1ui-theme={DEFAULT_THEME}>
  <head>
    <meta charset="UTF-8" />
    {
      /* Read by the UA to paint the canvas before a stylesheet has arrived.
         A theme's name is also its `color-scheme` keyword, so there is nothing
         to translate between this and the attribute above. */
    }
    <meta name="color-scheme" content={DEFAULT_THEME} />
    {
      /* Applies a stored theme choice before the first paint. A returning
         visitor who chose "light" would otherwise get one frame of the default
         above: the `[data-ps1ui-theme]` rules only arrive with tokens.css, and
         a bundled script not until the document has parsed.

         `is:inline` means no bundling and so no imports — the storage key and
         the theme names arrive as literals through `define:vars` rather than
         being spelled out a second time. */
    }
    <script
      is:inline
      define:vars={{ storageKey: THEME_STORAGE_KEY, themes: THEMES }}
    >
      try {
        const stored = localStorage.getItem(storageKey);
        if (themes.includes(stored)) {
          document.documentElement.dataset.ps1uiTheme = stored;
          document
            .querySelector('meta[name="color-scheme"]')
            ?.setAttribute("content", stored);
        }
      } catch {
        // Reading storage throws where site data is blocked. The default
        // written into <html> stands.
      }
    </script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- ogp -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={config.profile.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{fullTitle}</title>

    <ClientRouter />
  </head>
  <body>
    <PS1Root>
      <Stack gap="none" className={styles.page}>
        <SiteHeader currentPath={pathname} />
        {
          /* `queryContainer` here and nowhere else: this box is the content
            measure, so every responsive prop under it resolves against the
            column the content is actually laid out in. Left off, they would
            fall through to PS1Root — i.e. the window — and flip at widths the
            content column never reaches. */
        }
        <Container
          as="main"
          size="lg"
          px={{ base: "lg", sm: "xl" }}
          queryContainer
          className={styles.main}
        >
          <slot />
        </Container>
      </Stack>
    </PS1Root>
  </body>
</html>
